# Server-only credentials. Copy to .env and fill in. Never use NEXT_PUBLIC_ variables for secrets.
# Providers are tried in the order set in Settings; any provider without a key is skipped.

# https://console.groq.com/keys  (output is capped; its free tier allows 8K tokens a minute)
GROQ_API_KEY=
# Optional second key (another account) for the same provider; used when the first is out of quota or rejected.
# Any provider accepts one: GEMINI_API_KEY_FALLBACK, OPENROUTER_API_KEY_FALLBACK, CLOUDFLARE_API_TOKEN_FALLBACK, POLLINATIONS_API_KEY_FALLBACK.
GROQ_API_KEY_FALLBACK=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# https://dash.cloudflare.com  (Workers AI; also pick a model in Settings)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# https://enter.pollinations.ai/keys  (also pick a model in Settings)
POLLINATIONS_API_KEY=

# Optional default model per provider, used when Settings leaves the model blank.
# GROQ_MODEL=
# GEMINI_MODEL=
# OPENROUTER_MODEL=

# Optional, absolute path recommended. Default: ./data/ideaprompt.sqlite
# DATABASE_PATH=
# Per provider call, clamped to 10–180 seconds. Draft and review are separate calls.
PROVIDER_TIMEOUT_MS=90000
