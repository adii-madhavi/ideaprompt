# Server-only credentials. Never use NEXT_PUBLIC_ variables for secrets.
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
# Choose currently available chat models from each provider's catalog.
GROQ_MODEL=
OPENROUTER_MODEL=
# Optional, absolute path recommended. Default: ./data/ideaprompt.sqlite
# DATABASE_PATH=
# Per provider call, clamped to 10–180 seconds. Draft and review are separate calls.
PROVIDER_TIMEOUT_MS=90000
